# Local Docker ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Internal API URL used by server-side Next.js fetches and Next.js rewrites inside Docker Compose.
INTERNAL_API_URL=http://backend:8000

# Browser-facing API URL used by the Next.js frontend build.
#
# Local direct mode:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# INTERNAL_API_URL=http://backend:8000
#
# Single-public-URL tunnel mode:
# NEXT_PUBLIC_API_URL=
# INTERNAL_API_URL=http://backend:8000
#
# When NEXT_PUBLIC_API_URL is empty, browser requests use same-origin /api/*
# and the Next.js frontend proxies them to INTERNAL_API_URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# Backend CORS origins. Add deployed frontend domains here.
ANALYTICA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Runtime storage for local development. docker-compose overrides these inside the backend container.
ANALYTICA_RUNTIME_DIR=.analytica/runtime
ANALYTICA_UPLOAD_DIR=.analytica/uploads
ANALYTICA_ARTIFACT_DIR=artifacts
ANALYTICA_CHECKPOINTER_TYPE=memory
ANALYTICA_CHECKPOINTER_PATH=.analytica/checkpoints.sqlite

# LLM provider configuration. Fill one provider key locally or in the deployment dashboard.
ANALYTICA_LLM_PROVIDER=
ANALYTICA_LLM_MODEL=
OPEN_API_TOKEN=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional provider endpoints.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
